# TCASIA (OncoHarmony-Network/TCASIA_pipeline @ 06564ff1) — oxo-flow port
#
# Default-parameters main execution path. The two upstream Snakemake
# workflows are chained in one DAG (alignment bams feed the AS callers):
#
#   FASTQ -> fastp -> STAR -> samtools sort/index -> featureCounts
#         -> rMATS | MAJIQ | SUPPA2 (Salmon) | SplAdder
#
# Structure mirrors upstream:
#   modules/alignment.oxoflow  = workflows/01_alignment/Snakefile
#   modules/as_calling.oxoflow = workflows/02_as_calling/Snakefile
#   (+ rules/snakefile_* fragments folded in, same rule names)
#
# Run one stage only with -t: `oxo-flow run main.oxoflow -t alignment`
# (rule names are namespaced alignment::* / as_calling::*).
#
# Scope deviations from upstream (see README fidelity table):
#   - the samples TSV (sample_id/fastq_1/fastq_2) is replaced by
#     [[sample_groups]] + the reads_dir layout below (fastq paths must be
#     reads_dir/{sample}_1.fastq.gz / {sample}_2.fastq.gz)
#   - 01 output_dir/aligned and 02 bam_dir are one key (aligned_dir), so
#     the alignment -> AS-calling chain is structural
#   - strandness-derived values (salmon library type, MAJIQ strandness)
#     are explicit config keys — upstream computes them in tcasia_config.py

[workflow]
name = "tcasia"
version = "1.0.0"
description = "Paired-end RNA-seq alignment and four-caller alternative-splicing analysis (rMATS, MAJIQ, SUPPA2, SplAdder). oxo-flow port of OncoHarmony-Network/TCASIA_pipeline @ 06564ff1."
author = "oxo-flow-community"

[config]
# --- shared ---
strandness = "fr-firststrand"   # fr-firststrand | fr-secondstrand | fr-unstranded

# --- 01_alignment (upstream config.yml) ---
align_out_dir = "results/alignment"                # upstream: output_dir
aligned_dir = "results/alignment/aligned"          # upstream: 01 output_dir/aligned == 02 bam_dir
# star_index_dir is auto-built below from test/fixtures/reference (tiny
# synthetic genome) — point it at a real GRCh38 STAR index for real runs.
star_index_dir = "test/fixtures/reference/STAR_index"
ref = "test/fixtures/reference/genes.gtf"      # featureCounts / rMATS / SplAdder annotation (tiny synthetic; GRCh38 GTF for real runs)
reads_dir = "test/fixtures/raw"   # point at your own fastq directory for real runs

# fastp (upstream fastp.*)
fastp_min_length = 36
fastp_qualified_quality_phred = 20
fastp_unqualified_percent_limit = 40
fastp_n_base_limit = 5

# STAR (upstream star.*)
star_out_filter_mismatch_nmax = 15
star_limit_bam_sort_ram = 39050942993

# --- 02_as_calling (upstream config.yml) ---
as_out_dir = "results/as_calling"                  # upstream: output_dir
gff = "test/fixtures/reference/genes.gff3"    # upstream: GFF (tiny synthetic)
# MAJIQ requires the upstream academic license file — place it at
# test/fixtures/reference/majiq_license.lic (obtain from MAJIQ) or the
# MAJIQ stage fails. Unlicensed real runs need the same file.
majiq_license = "test/fixtures/reference/majiq_license.lic"
# suppa2_events is auto-built below from the shipped GTF (SUPPA2 generateEvents)
suppa2_events = "test/fixtures/reference/events.ioe"
# salmon_index is auto-built below from the shipped transcripts.fa
salmon_index = "test/fixtures/reference/salmon_index"
read_len = 150

# Derived from `strandness` by upstream tcasia_config.py; kept explicit here:
salmon_library_type = "ISR"      # fr-firststrand -> ISR | fr-secondstrand -> ISF | fr-unstranded -> IU
majiq_strandness = "reverse"     # fr-firststrand -> reverse | fr-secondstrand -> forward | fr-unstranded -> none
# rMATS library type IS the strandness value (upstream: RMATS_LIBRARY_TYPE = STRANDNESS)

rmats_cstat = 0.0001
rmats_extra = ""
majiq_genome = "hg38"
majiq_minreads = 10
suppa2_min_tpm = 1
spladder_confidence = 3
spladder_merge_strategy = "single"
spladder_event_types = "exon_skip,intron_retention,alt_3prime,alt_5prime,mutex_exons"

# Upstream samples.tsv declares sample_01; the port ships two synthetic samples
# (test/fixtures/raw/sample_0{1,2}_{1,2}.fastq.gz) so a fresh clone runs end-to-end.

# === Auto-built references (tiny synthetic kit; swap paths for real data) ===
[[references]]
name = "star_index_dir"
source = "test/fixtures/reference/genome.fa"
output = "test/fixtures/reference/STAR_index"
build = "STAR --runMode genomeGenerate --genomeDir {output} --genomeFastaFiles {source} --sjdbGTFfile test/fixtures/reference/genes.gtf --runThreadN 8"
threads = 8
memory = "16G"

[references.environment]
conda = "envs/ega.yaml"

[[references]]
name = "salmon_index"
source = "test/fixtures/reference/transcripts.fa"
output = "test/fixtures/reference/salmon_index"
build = "salmon index -t {source} -i {output}"

[references.environment]
conda = "envs/SUPPA2.yaml"

[[references]]
name = "suppa2_events"
source = "test/fixtures/reference/genes.gtf"
output = "test/fixtures/reference/events.ioe"
build = "suppa.py generateEvents -i {source} -o test/fixtures/reference/events -f ioe -e SE SS MX RI FL"

[references.environment]
conda = "envs/SUPPA2.yaml"

[[sample_groups]]
name = "cohort"
samples = ["sample_01", "sample_02"]

[[include]]
path = "modules/alignment.oxoflow"
namespace = "alignment"

[[include]]
path = "modules/as_calling.oxoflow"
namespace = "as_calling"
